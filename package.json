{
  "name": "welcome-tour",
  "private": true,
  "version": "1.0.1",
  "repository": "https://gitlab.com/beamgroup/beam-www",
  "description": "Beam website",
  "author": "beam",
  "engines": {
    "node": "^16.13.0"
  },
  "scripts": {
    "clean": "rm -Rf node_modules && rm -rf dist",
    "prebuild": "yarn install",
    "start:dev": "webpack serve --mode=development",
    "start": "webpack serve",
    "build": "webpack --mode=development",
    "dist": "webpack --mode=production",
    "postbuild": "mv ./dist/assets/_redirects ./dist/_redirects && mv ./dist/assets/.well-known ./dist/",
    "lint": "eslint . --ext .ts --format gitlab .",
    "test": "jest --passWithNoTests",
    "test-watch": "jest --watchAll --passWithNoTests",
    "test-ci": "jest --ci --reporters=default --reporters=jest-junit --coverage --passWithNoTests",
    "release:patch": "yarn version --patch && git push --follow-tags",
    "release:feature": "yarn version --minor && git push --follow-tags",
    "release:major": "yarn version --major && git push --follow-tags"
  },
  "pre-commit": [
    "lint",
    "test"
  ],
  "targets": {
    "browser": {
      "source": [
        "src/index.html"
      ],
      "sourceMap": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/plugin-proposal-class-properties": "^7.16.0",
    "@babel/plugin-transform-runtime": "^7.16.0",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-typescript": "^7.16.0",
    "@babel/runtime-corejs3": "^7.16.0",
    "@types/debounce": "^1.2.1",
    "@types/headroom.js": "^0.12.2",
    "@types/html": "^1.0.1",
    "@types/jest": "^27.0.3",
    "@types/paper": "^0.12.3",
    "@typescript-eslint/eslint-plugin": "^4.28.4",
    "@typescript-eslint/parser": "^4.28.4",
    "copy-webpack-plugin": "^9.0.1",
    "css-loader": "^5.2.4",
    "dotenv": "^10.0.0",
    "eslint": "^7.31.0",
    "eslint-formatter-gitlab": "^2.2.0",
    "favicons": "^6.2.2",
    "favicons-webpack-plugin": "^5.0.2",
    "html": "^1.0.0",
    "html-inline-css-webpack-plugin": "^1.11.1",
    "html-webpack-plugin": "^5.3.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "27.3.1",
    "jest-canvas-mock": "^2.3.1",
    "jest-css-modules": "^2.1.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-junit": "^13.0.0",
    "jsdom-global": "^3.0.2",
    "mini-css-extract-plugin": "^2.5.3",
    "posthtml-expressions": "^1.7.1",
    "pre-commit": "^1.2.2",
    "sass": "1.32.8",
    "sass-loader": "^11.0.1",
    "source-map-loader": "^3.0.0",
    "style-loader": "^2.0.0",
    "stylelint": "^13.13.1",
    "stylelint-config-sass-guidelines": "^8.0.0",
    "ts-jest": "^27.0.7",
    "ts-loader": "^9.1.0",
    "ts-node": "^10.4.0",
    "tsconfig-paths": "^3.11.0",
    "typescript": "^4.3.2",
    "webpack": "^5.52.0",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "4.9.1",
    "webpack-dev-server": "^4.1.1",
    "workbox-webpack-plugin": "^6.2.4"
  },
  "dependencies": {
    "@ungap/custom-elements": "^1.0.2",
    "debounce": "^1.2.1",
    "gsap": "^3.11.3",
    "headroom.js": "^0.12.0",
    "paper": "^0.12.16"
  }
}
